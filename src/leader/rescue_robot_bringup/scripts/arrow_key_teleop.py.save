#!/usr/bin/env python3

"""Low-speed, deadman-style arrow-key teleoperation for the leader robot."""

import os
import select
import sys
import termios
import time
import tty

from geometry_msgs.msg import Twist
import rclpy
from rclpy.node import Node


ARROW_KEYS = {
    "\x1b[A": "forward",
    "\x1b[B": "reverse",
    "\x1b[C": "right",
    "\x1b[D": "left",
}


class ArrowKeyTeleop(Node):
    """Publish Twist commands while terminal key-repeat remains active."""

    def __init__(self):
        super().__init__("arrow_key_teleop")

        self.declare_parameter("command_topic", "/leader/cmd_vel")
        self.declare_parameter("linear_speed", 0.12)
        self.declare_parameter("angular_speed", 0.35)
        self.declare_parameter("key_timeout", 0.25)
        self.declare_parameter("publish_rate", 20.0)

        if not sys.stdin.isatty():
            raise RuntimeError("arrow_key_teleop must run in an interactive terminal")

        command_topic = str(self.get_parameter("command_topic").value)
        publish_rate = float(self.get_parameter("publish_rate").value)
COMBINATION_KEYS = {
    "q": "forward_left",
    "w": "forward_right",
    "a": "reverse_left",
    "s": "reverse_right",
}        if publish_rate <= 0.0:
            raise ValueError("publish_rate must be greater than zero")

        self._publisher = self.create_publisher(Twist, command_topic, 10)
        self._stdin_fd = sys.stdin.fileno()
        self._terminal_settings = termios.tcgetattr(self._stdin_fd)
        self._input_buffer = ""
        self._motion = None
        self._last_motion_key_time = 0.0
        self._terminal_configured = False

        tty.setcbreak(self._stdin_fd)
        self._terminal_configured = True
        self.create_timer(1.0 / publish_rate, self._update)

        self.get_logger().info(
            f"Arrow-key teleop -> {command_topic}. "
            "Hold an arrow key to move; release to stop. SPACE stops immediately."
        )
        self._print_controls()

    @staticmethod
    def _print_controls():
        print(
            "\n"
            "        UP: forward\n"
            "LEFT / RIGHT: rotate\n"
            "      DOWN: reverse\n"
            "     SPACE: stop\n"
            "    Ctrl-C: exit\n",
            flush=True,
        )

    def _update(self):
        self._read_available_input()
        self._publisher.publish(self._command_for_current_state())

    def _read_available_input(self):
        while select.select([self._stdin_fd], [], [], 0.0)[0]:
            data = os.read(self._stdin_fd, 32)
            if not data:
                break
            self._input_buffer += data.decode("latin1")

        while self._input_buffer:
            if self._input_buffer.startswith("\x1b"):
                if len(self._input_buffer) < 3:
                    return
                sequence = self._input_buffer[:3]
                self._input_buffer = self._input_buffer[3:]
                motion = ARROW_KEYS.get(sequence)
                if motion is not None:
                    self._motion = motion
                    self._last_motion_key_time = time.monotonic()
                continue

            key = self._input_buffer[0]
            self._input_buffer = self._input_buffer[1:]
            if key == " ":
                self._motion = None
                self._last_motion_key_time = 0.0

    def _command_for_current_state(self):
        command = Twist()
        timeout = float(self.get_parameter("key_timeout").value)
        if (
            self._motion is None
            or time.monotonic() - self._last_motion_key_time > timeout
        ):
            self._motion = None
            return command

        linear_speed = float(self.get_parameter("linear_speed").value)
        angular_speed = float(self.get_parameter("angular_speed").value)
        if self._motion == "forward":
            command.linear.x = linear_speed
        elif self._motion == "reverse":
            command.linear.x = -linear_speed
        elif self._motion == "left":
            command.angular.z = angular_speed
        elif self._motion == "right":
            command.angular.z = -angular_speed
        return command

    def stop(self):
        self._motion = None
        self._publisher.publish(Twist())

    def restore_terminal(self):
        if self._terminal_configured:
            termios.tcsetattr(
                self._stdin_fd,
                termios.TCSADRAIN,
                self._terminal_settings,
            )
            self._terminal_configured = False

    def destroy_node(self):
        self.restore_terminal()
        return super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = None
    try:
        node = ArrowKeyTeleop()
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node is not None:
            # rclpy's SIGINT handler may invalidate the context before control
            # reaches this block. In that case the STM32 command watchdog is
            # the final stop boundary, and publishing would raise RCLError.
            if rclpy.ok():
                node.stop()
                time.sleep(0.05)
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
